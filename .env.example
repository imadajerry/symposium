# ==========================================
# Symposium - Environment Config
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=symposium
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DB_PORT=5432

# Backend Security & JWT
JWT_SECRET=replace_with_a_random_secure_32_character_string_here
JWT_TTL_SECONDS=86400

# Google Gemini AI Integration (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Ollama Local LLM (if not using Gemini)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=80

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
